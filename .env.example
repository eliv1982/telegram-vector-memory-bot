PINECONE_API_KEY=
PINECONE_INDEX_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=
TELEGRAM_BOT_TOKEN=

# Experimental and off by default: a high similarity score cannot distinguish a paraphrase
# from an updated fact. Exact duplicates are always skipped regardless of this flag.
MEMORY_SEMANTIC_DEDUP_ENABLED=false
# Used only when MEMORY_SEMANTIC_DEDUP_ENABLED=true. Not calibrated.
MEMORY_SIMILARITY_THRESHOLD=0.50
MEMORY_TOP_K=5
MEMORY_NAMESPACE_PREFIX=telegram-user
# DEBUG, INFO, WARNING, ERROR or CRITICAL. DEBUG enables verbose third-party logging that may
# include request payloads; use it only locally.
LOG_LEVEL=INFO

# Optional DocuScope settings for hay_v2_bot
DOCUSCOPE_MAX_FILE_BYTES=20971520
DOCUSCOPE_MAX_CHUNKS_PER_DOCUMENT=2000
DOCUSCOPE_EMBEDDING_DIMENSIONS=1536
DOCUSCOPE_RETRIEVAL_TOP_K=4
DOCUSCOPE_MAX_SUMMARY_CHARS=12000
DOCUSCOPE_MAX_QUESTION_CHARS=4000
